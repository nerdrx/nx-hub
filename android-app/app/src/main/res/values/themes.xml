<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DeviceDefault keeps us free of appcompat/material; the Pico's system theme
         is dark already and this pins every colour we care about anyway. -->
    <style name="Theme.NXHub" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:colorPrimary">@color/nx_violet</item>
        <item name="android:colorAccent">@color/nx_violet</item>
        <item name="android:colorSecondary">@color/nx_cyan</item>
        <item name="android:windowBackground">@drawable/bg_space</item>
        <item name="android:statusBarColor">@color/nx_bg</item>
        <item name="android:navigationBarColor">@color/nx_bg</item>
        <item name="android:textColorPrimary">@color/nx_text</item>
        <item name="android:textColorSecondary">@color/nx_muted</item>
        <item name="android:textColorHint">@color/nx_dim</item>
    </style>

    <style name="Theme.NXHub.Dialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">@color/nx_violet</item>
        <item name="android:textColorPrimary">@color/nx_text</item>
        <item name="android:textColorSecondary">@color/nx_muted</item>
        <item name="android:textColorHint">@color/nx_dim</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>

    <style name="NXButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">104dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
