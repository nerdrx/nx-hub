<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/appName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/nx_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_bg"
            android:paddingLeft="10dp"
            android:paddingTop="3dp"
            android:paddingRight="10dp"
            android:paddingBottom="3dp"
            android:textColor="@color/nx_cyan"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tagline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/nx_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/versionLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/nx_dim"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/rowProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_cyan"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/primaryButton"
            style="@style/NXButton"
            android:background="@drawable/btn_violet"
            android:textColor="#ffffff" />

        <Button
            android:id="@+id/secondaryButton"
            style="@style/NXButton"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_outline_cyan"
            android:textColor="@color/nx_cyan"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/notesButton"
            style="@style/NXButton"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_ghost"
            android:minWidth="76dp"
            android:text="@string/notes"
            android:textColor="@color/nx_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/notesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/edit_bg"
        android:lineSpacingExtra="2dp"
        android:padding="12dp"
        android:textColor="@color/nx_muted"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
