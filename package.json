{
  "name": "nx-hub",
  "productName": "NX Hub",
  "version": "0.2.0",
  "description": "NX Hub — installer, updater and launcher for the NX app family",
  "main": "src/main/index.js",
  "author": "nerdrx",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core test/install test/ui",
    "e2e": "node test/e2e.js",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nxhub.app",
    "productName": "NX Hub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "registry/**/*",
      "package.json",
      "!test/**/*",
      "!dist/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons",
      "category": "Utility",
      "artifactName": "NX-Hub-${version}-linux.${ext}",
      "synopsis": "Installer, updater and launcher for the NX app family",
      "desktop": {
        "GenericName": "Application Manager",
        "StartupWMClass": "NX Hub",
        "Keywords": "nx;install;update;launcher;appimage;"
      }
    },
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "artifactName": "NX-Hub-${version}-windows-portable.${ext}"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "electron-builder@24.13.3": true
  }
}
